
# ========== MySQL ==========
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=zhilian
MYSQL_ROOT_PASSWORD=your_password_here

# ========== Redis ==========
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ========== Elasticsearch ==========
ES_HOST=http://localhost:9200
ES_USER=elastic
ES_PASSWORD=your_password_here
ELASTIC_PASSWORD=your_password_here

# ========== DeepSeek LLM ==========
DEEPSEEK_API_KEY=sk-your_api_key_here
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro          
# [必填] 注册地址: https://platform.deepseek.com/


# ========== 天聚数行 TianAPI ==========
TIANAPI_KEY=your_api_key_here
TIANAPI_BASE=https://apis.tianapi.com
# [可选] 注册地址: https://www.tianapi.com/


# ========== 数据采集（网络爬虫） ==========
# RSS 订阅源（逗号分隔，免费无需 key）
RSS_SOURCES=https://www.chinanews.com.cn/rss/scroll-news.xml
# 网页抓取目标（逗号分隔）
CRAWL_TARGETS=
CRAWL_TIMEOUT=10



 # ========== QQ邮箱通知 ==========
 # [可选] QQ邮箱 → 设置 → 账户 → POP3/IMAP/SMTP → 生成授权码
 QQ_EMAIL_SENDER=
 QQ_EMAIL_AUTH_CODE=
 QQ_EMAIL_RECEIVER=


 # ========== 后端服务 ==========
 BACKEND_HOST=0.0.0.0
 BACKEND_PORT=8000
 ALLOWED_ORIGINS=http://localhost:3000


 # ========== 文件存储 ==========
EXPORT_DIR=./runtime/exports
TEMPLATE_DIR=./templates